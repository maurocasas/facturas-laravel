{
    "name": "maurocasas/facturas-laravel",
    "description": "Facturación electrónica ARCA / AFIP para Laravel: facturas, notas de crédito y débito, exportación y Padrón. Port del SDK facturas (facturas-sdk.dev).",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["arca", "afip", "argentina", "wsaa", "wsfe", "wsfex", "wsmtxca", "padron", "factura", "facturacion-electronica", "cae", "laravel"],
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "dompdf/dompdf": "^3.0",
        "chillerlan/php-qrcode": "^5.0"
    },
    "suggest": {
        "dompdf/dompdf": "Para generar el PDF del comprobante impreso (Vant\\Facturas\\Pdf\\VoucherPdf).",
        "chillerlan/php-qrcode": "Para dibujar el QR de ARCA en el PDF del comprobante impreso.",
        "illuminate/database": "Para el store de base de datos (DatabaseStore).",
        "illuminate/redis": "Para el store de Redis (RedisStore)."
    },
    "autoload": {
        "psr-4": {
            "Vant\\Facturas\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Vant\\Facturas\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vant\\Facturas\\FacturasServiceProvider"
            ],
            "aliases": {
                "Arca": "Vant\\Facturas\\Facades\\Arca"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
